{
    "manifest_version": 3,
    "name": "Postglider",
    "version": "1.0.0",
    "description": "Premium RSS Postglider",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "index.html",
        "default_title": "Postglider"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "led-tile.png",
                "content.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}